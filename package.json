{
  "name": "diarydock",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --experimental-strip-types tools/check-release-environment.mts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:source-size": "node tools/check-source-size.mjs",
    "check:source-size:strict": "node tools/check-source-size.mjs --strict",
    "mobile:dev": "npm run dev --workspace @diarydock/mobile",
    "mobile:build": "npm run build --workspace @diarydock/mobile",
    "mobile:typecheck": "npm run typecheck --workspace @diarydock/mobile",
    "scanner:typecheck": "npm run typecheck --workspace @diarydock/malware-scanner",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.mts",
    "test:rls:household": "node --experimental-strip-types tools/test-household-sharing-rls.ts",
    "load:health": "k6 run tools/load/health.js",
    "load:sync": "k6 run tools/load/sync-pull.js",
    "load:sync:push": "k6 run tools/load/sync-push.js",
    "check": "npm run check:source-size && npm run typecheck && npm run mobile:typecheck && npm run scanner:typecheck && npm run lint && npm test && npm run build && npm run mobile:build",
    "promo:render": "remotion render promo-video/index.ts DiaryDockPromo output/diarydock-promo.mp4",
    "icons:generate": "node tools/generate-app-icons.mjs",
    "assets:generate": "npm run icons:generate",
    "ios:sync": "npm run mobile:build && npm run assets:generate && npx cap sync ios",
    "android:sync": "npm run mobile:build && npm run assets:generate && npx cap sync android",
    "release:testflight": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/create-testflight-release.ps1",
    "release:android": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/create-android-release.ps1",
    "release:preflight": "node --experimental-strip-types tools/check-release-environment.mts --production"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/share": "^8.0.0",
    "@fastify/busboy": "^3.2.2",
    "@diarydock/home-handover": "*",
    "@diarydock/life-check": "*",
    "@diarydock/onboarding": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@remotion/media": "^4.0.494",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/otel": "^2.1.3",
    "next": "^16.3.0",
    "openai": "^6.48.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@electric-sql/pglite": "^0.5.8",
    "@remotion/cli": "^4.0.327",
    "@types/node": "22.15.30",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "remotion": "^4.0.327",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.66.0",
    "yaml": "^2.9.0"
  }
}
