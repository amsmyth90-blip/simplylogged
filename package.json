{
  "name": "diarydock",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.mts",
    "test:rls:household": "node --experimental-strip-types tools/test-household-sharing-rls.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "promo:render": "remotion render promo-video/index.ts DiaryDockPromo output/diarydock-promo.mp4",
    "icons:generate": "node tools/generate-app-icons.mjs",
    "assets:generate": "npm run icons:generate && npx --yes @capacitor/assets@3.0.5 generate --ios --android",
    "ios:sync": "npm run assets:generate && npx cap sync ios",
    "android:sync": "npm run assets:generate && npx cap sync android",
    "release:testflight": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/create-testflight-release.ps1",
    "release:android": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/create-android-release.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@remotion/media": "^4.0.494",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "next": "^16.3.0",
    "openai": "^6.48.0",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.20.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@remotion/cli": "^4.0.327",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "remotion": "^4.0.327",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.66.0"
  }
}
