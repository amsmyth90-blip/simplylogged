NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5

# Server-only. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=
ACCOUNT_DELETION_ADMIN_TOKEN=
ACCOUNT_DELETION_ADMIN_EMAILS=

# Server-only inbound email integration.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
DIARYDOCK_INBOUND_WEBHOOK_SECRET=
DIARYDOCK_INBOUND_EMAIL_SECRET=
DIARYDOCK_INBOUND_EMAIL_DOMAIN=inbound.diarydock.com
DIARYDOCK_INBOUND_EMAIL_PROVIDER_READY=false

# Disposable/local project only. Used by `npm run test:rls:household`.
DIARYDOCK_RLS_SUPABASE_URL=
DIARYDOCK_RLS_SUPABASE_ANON_KEY=
DIARYDOCK_RLS_SUPABASE_SERVICE_ROLE_KEY=
DIARYDOCK_RLS_TEST_CONFIRM=
# Leave false unless the currently linked project is itself disposable.
DIARYDOCK_RLS_ALLOW_LINKED_PROJECT=false

# Fail closed when a real capture malware scanner is required. Leave false while only signature validation is configured.
DIARYDOCK_CAPTURE_SCANNER_REQUIRED=false
