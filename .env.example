NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_API_ORIGIN=https://diarydock.com
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5
OPENAI_VISION_MODEL=gpt-5

# Server-only. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Unique 32-512 character server credential.
ACCOUNT_DELETION_ADMIN_TOKEN=
CRON_SECRET=
ACCOUNT_DELETION_ADMIN_EMAILS=

# Server-only inbound email integration.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
DIARYDOCK_INBOUND_WEBHOOK_SECRET=
DIARYDOCK_INBOUND_EMAIL_SECRET=
DIARYDOCK_INBOUND_EMAIL_DOMAIN=inbound.diarydock.com
DIARYDOCK_INBOUND_EMAIL_PROVIDER_READY=false

# Disposable/local project only. Used by `npm run test:rls:household`.
DIARYDOCK_RLS_SUPABASE_URL=
DIARYDOCK_RLS_SUPABASE_ANON_KEY=
DIARYDOCK_RLS_SUPABASE_SERVICE_ROLE_KEY=
DIARYDOCK_RLS_TEST_CONFIRM=
# Leave false unless the currently linked project is itself disposable.
DIARYDOCK_RLS_ALLOW_LINKED_PROJECT=false

# Private malware-scanning service. Production fails closed if this boundary is unavailable.
# The token must be a unique 32-512 character credential and match only the scanner service.
DIARYDOCK_CAPTURE_SCANNER_REQUIRED=true
DIARYDOCK_MALWARE_SCANNER_URL=
DIARYDOCK_MALWARE_SCANNER_TOKEN=

# OpenTelemetry export is connected through a Vercel integration or an OTLP collector.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
DIARYDOCK_OBSERVABILITY_SAMPLE_RATE=0.01

# Server-only HMAC key for opaque mobile sync cursors (a unique 32-512 character credential).
DIARYDOCK_SYNC_CURSOR_SECRET=
